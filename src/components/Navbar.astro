---
import { Icon } from "astro-icon/components";

---

<nav class="nav">
  <a class="left" href="/">Max DeWeese</a>

  <div class="right">
  <a href="https://github.com/MaxDeWeese" target="_blank">
    <Icon name="mdi:github" size={24} />
    <span>GitHub</span>
  </a>
  <a href="https://loadin9.itch.io/" target="_blank" rel="noopener noreferrer">
    <Icon name="simple-icons:itchdotio" size={20} />
    <span>Itch.io</span>
  </a>

  <a href="https://www.linkedin.com/in/max-deweese" target="_blank">
    <Icon name="mdi:linkedin" size={24} />
    <span>LinkedIn</span>
  </a>

  <a href="mailto:maximiliandeweese@gmail.com">
    <Icon name="mdi:email-outline" size={24} />
    <span>Email</span>
  </a>
</div>
</nav>

<style>
.nav {
  position: sticky;
  top: 0;
  z-index: 100;

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 10px 32px;

  background: rgba(252, 252, 252, 0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);

  border-bottom: 1px solid rgba(0, 0, 0, 0.08);

}

.left {
  font-size: 26px;
  font-weight: 450;
  text-decoration: none;
  color: #111;
  letter-spacing: -0.04em;
    transition: color 150ms ease;

}
.left:hover {
  color: #666;
}

.right {
  display: flex;
  align-items: center;
  gap: 32px;
}

.right a {
  display: flex;
  align-items: center;
  gap: 6px;

  text-decoration: none;
  color: #666;

  font-size: 18px;
  font-weight: 450;
  letter-spacing: -0.02em;

  transition: color 150ms ease;
}

.right a:hover {
  color: #111;
}
</style>