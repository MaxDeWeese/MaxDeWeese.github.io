---
import { getCollection } from "astro:content";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";



export async function getStaticPaths() {
  const projects = await getCollection("projects");
  

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<html lang="en">
  <head>
    <title>{project.data.title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta charset="UTF-8" />
    <link rel="stylesheet" href="/global.css" />
  </head>

  <body>
    <Navbar />

    <main class="page">


      <h1>{project.data.title}</h1>
      <!-- 
      <img
        src={project.data.images[0]}
        alt={project.data.title}
        class="cover"
      />-->

<div class="carousel">
  <button class="arrow left" onclick="prevImage()">&larr;</button>

  <div class="track">
    {
      project.data.gallery.map((item) => (
        <div class="slide">
          {item.type === "image" ? (
          <div class="image-frame">
            <img src={item.src} alt={item.caption ?? ""} />
              {item.caption && (
                <div class="caption">{item.caption}</div>
              )}
            </div>
          ) : (
        <>
        <iframe
          src={`https://www.youtube.com/embed/${item.id}`}
          title="YouTube video"
          allowfullscreen
        />

      
    </>
  )}
</div>
      ))
    }
  </div>

  <button class="arrow right" onclick="nextImage()">&rarr;</button>
</div>

      

      <div class="content" set:html={project.rendered?.html ?? ""} />

    </main>
    <Footer />
  </body>
</html>

<style>
 /* ---------- Page ---------- */

.page {
  max-width: 1050px;
  margin: 0 auto;

  padding: 48px 28px 80px;
}


/* ---------- Title ---------- */

.page h1 {
  font-size: 30px;

  margin-top: 0;
  margin-bottom: 16px;

  text-align: center;

  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.15;

  color: #222;
}


/* ---------- Markdown Content ---------- */

.content {
  max-width: 900px;

  margin: 48px auto 0;

  color: #222;

  font-size: 16px;
  line-height: 1.7;
}


.content h2 {
  margin-top: 56px;
  margin-bottom: 16px;

  font-size: 20px;

  font-weight: 400;
  letter-spacing: -0.035em;
  line-height: 1.3;

  color: #222;
}


.content h3 {
  margin-top: 36px;
  margin-bottom: 12px;

  font-size: 16px;

  font-weight: 400;
  letter-spacing: -0.025em;
  line-height: 1.3;

  color: #222;
}


.content p {
  margin: 18px 0;
}


.content ul {
  padding-left: 22px;
}


.content li {
  margin: 8px 0;
}



/* Image Stuff */


.caption {
  position: absolute;
  bottom: 8px;
  left: 6px;

  background: rgba(0, 0, 0, 0.55);
  color: white;

  padding: 4px 10px;
  border-radius: 4px;

  font-size: 13px;
  line-height: 1.3;

  max-width: 80%;
  text-align: left;

  backdrop-filter: blur(6px);

  pointer-events: none;
}

.carousel {
  position: relative;
  max-width: 1000px;
  height: 550px;
  margin: 40px auto;
  margin-top: 12px;

  background: #e5e5e5;
  border-radius: 4px;
  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;
}

.track {
  width: 100%;
  height: 100%;
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);

  width: 46px;
  height: 46px;

  border-radius: 4px;
  border: none;

  background: rgba(252,252,252,0.9);
  cursor: pointer;

  z-index: 10;

  display: flex;
  align-items: center;
  justify-content: center;

  /*  FIX GARBLED TEXT */
  font-size: 24px;
  line-height: 1;
  font-family: system-ui, -apple-system, sans-serif;

  color: #111;
  user-select: none;
}

.arrow.left { left: 14px; }
.arrow.right { right: 14px; }
.slide {
  position: absolute;
  inset: 0;

  display: flex;
  justify-content: center;

  opacity: 0;
  transition: opacity 0.3s ease;
      object-fit: contain;

}

.slide img {
  max-width: 100%;
  max-height: 100%;

  object-fit: contain;
  display: block;
}
.slide iframe {
  width: 100%;
  height: 100%;
  display: block;
}
.image-frame {
  position: relative;

  display: inline-block;
  max-width: 100%;
  max-height: 100%;
    object-fit: fill;


}

</style>

<script is:inline>
  let current = 0;
  let slides = [];

  function showSlide(index) {
    slides.forEach((s, i) => {
      s.style.opacity = i === index ? "1" : "0";
      s.style.pointerEvents = i === index ? "auto" : "none";
    });
  }

  function nextImage() {
    current = (current + 1) % slides.length;
    showSlide(current);
  }

  function prevImage() {
    current = (current - 1 + slides.length) % slides.length;
    showSlide(current);
  }

  document.addEventListener("DOMContentLoaded", () => {
    slides = document.querySelectorAll(".slide");
    showSlide(0);
  });
</script>